{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YounityStudios/url-tracking-parameters/schema/tracking-parameters.schema.json",
  "title": "URL tracking parameter rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesVersion",
    "globalParameters",
    "parameterPrefixes",
    "hostParameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesVersion": {
      "type": "integer",
      "minimum": 1
    },
    "globalParameters": {
      "$ref": "#/$defs/parameterList"
    },
    "parameterPrefixes": {
      "$ref": "#/$defs/parameterList"
    },
    "hostParameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameterList"
      },
      "propertyNames": {
        "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9-]{2,63}$"
      }
    }
  },
  "$defs": {
    "parameterList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9._~-]+$"
      }
    }
  }
}
